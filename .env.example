# Copy to .env.local and fill in your own key(s).
# Finnhub market-data API key — https://finnhub.io/dashboard

# Server-side key used by the BFF (server/) for symbol search + quotes.
# Never exposed to the browser. Preferred going forward.
FINNHUB_API_KEY=

# Client-exposed key — used ONLY by the live WebSocket (src/services/marketStream.ts),
# which stays frontend-direct for now (ADR-015). Note: the WS URL still carries this
# key, so it remains exposed until streaming moves server-side (revisit at deploy).
VITE_FINNHUB_API_KEY=
