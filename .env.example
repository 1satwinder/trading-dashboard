# Copy to .env.local and fill in your own key(s).
# Finnhub market-data API key — https://finnhub.io/dashboard

# Server-side key used by the BFF (server/) for symbol search + quotes.
# Never exposed to the browser. Preferred going forward.
FINNHUB_API_KEY=

# Client-exposed key — used ONLY by the live WebSocket (src/services/marketStream.ts),
# which stays frontend-direct for now (ADR-015). Note: the WS URL still carries this
# key, so it remains exposed until streaming moves server-side (revisit at deploy).
VITE_FINNHUB_API_KEY=

# Alpaca credentials — used server-side by the BFF (server/alpaca.ts). Never
# exposed to the browser. The SAME paper-account key/secret cover both Alpaca APIs:
#   - Market Data (data.alpaca.markets): chart candles, free IEX feed.
#   - Trading (paper-api.alpaca.markets): account + positions (read-only for now).
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional host overrides (defaults shown). Change ALPACA_TRADING_URL to the live
# host only when going beyond paper trading.
# ALPACA_DATA_URL=https://data.alpaca.markets
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets
