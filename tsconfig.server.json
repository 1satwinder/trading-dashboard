// TSConfig for the backend-for-frontend (BFF) in `server/` (run via tsx in dev) and
// its Netlify Functions entry point in `netlify/` (production).
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["server/**/*", "netlify/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  }
}
